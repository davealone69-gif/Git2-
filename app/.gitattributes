# Auto detect text files and perform LF normalization
* text=auto

# Declare files that will always have LF line endings on checkout.
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.java text eol=lf
*.md text eol=lf
*.json text eol=lf
*.properties text eol=lf

# Denote all files that are truly binary and must not be modified by Git
*.jar binary
*.png binary
*.webp binary
*.keystore binary
